{% extends 'base.html.twig' %}{% block title %}Ссылка создана — CopyPaste{% endblock %}{% block body %}<section class="card"><h1>Ссылка готова</h1><label for="paste-url">Ссылка для получателя</label><div class="copy-row"><input id="paste-url" readonly value="{{ paste_url }}"><button type="button" data-copy="#paste-url">Скопировать</button></div><p class="notice">Ссылка действует до {{ paste.expiresAt|date('d.m.Y H:i') }}. Ключ никому не передаётся через сервер — сообщите его получателю отдельно.</p></section>{% endblock %}{% block javascripts %}<script src="{{ asset('copy.js') }}" defer></script>{% endblock %}
