{% extends 'base.html.twig' %}{% block title %}Открыть запись — CopyPaste{% endblock %}{% block body %}<section class="card"><h1>Зашифрованная запись</h1>{% if paste.hint %}<p><strong>Подсказка:</strong> {{ paste.hint }}</p>{% endif %}<p class="muted">Введите ключ, который отправитель сообщил вам отдельно.</p>{{ form_start(form) }}{{ form_errors(form) }}{{ form_row(form.secret) }}<button type="submit">Расшифровать</button>{{ form_end(form) }}</section>{% endblock %}
