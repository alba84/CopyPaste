{% extends 'base.html.twig' %}
{% block title %}Открыть запись — CopyPaste{% endblock %}
{% block body %}
<section class="card" aria-labelledby="unlock-title">
    <h1 id="unlock-title">У вас защищённое сообщение</h1>
    {% if paste.hint %}<div class="tag tag-outline hint">Подсказка: {{ paste.hint }}</div>{% endif %}
    <p class="lead">Введите ключ, который отправитель передал вам отдельно.</p>
    {{ form_start(form, {attr: {class: 'paste-form'}}) }}
        {{ form_errors(form) }}
        {{ form_row(form.secret, {attr: {class: 'input', placeholder: 'Введите ключ'}, row_attr: {class: 'field'}}) }}
        <button class="btn btn-primary btn-block" type="submit">Расшифровать</button>
    {{ form_end(form) }}
</section>
{% endblock %}
